# GitHub repository that publishes desktop installers, as owner/name.
# Download buttons read the latest release from this repository.
# The site defaults to amirrezaalasti/LetsWritePaper when this is unset.
GITHUB_REPOSITORY=amirrezaalasti/LetsWritePaper

# Optional. Public site URL used for Open Graph metadata.
# On Vercel this falls back to the production domain.
# NEXT_PUBLIC_SITE_URL=https://letswritepaper.vercel.app
